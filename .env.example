# ─────────────────────────────────────────────────────────────
#  Team Assistant Bot — Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Pinecone
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=team-assistant
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# OpenAI via proxyapi.ru
# Base URL for OpenAI-compatible proxy (proxyapi.ru)
OPENAI_BASE_URL=https://openai.api.proxyapi.ru/v1

# ProxyAPI key — used as the OpenAI API key when calling proxyapi.ru
# Requirement variable name: PROXYAPI_API_KEY
PROXYAPI_API_KEY=your_proxyapi_key_here

# OpenAI model for chat/generation
OPENAI_MODEL=gpt-4o-mini

# Embedding model — must match EMBEDDING_DIM in bot.py
# text-embedding-3-small → 1536 dims  (cheaper, faster)
# text-embedding-3-large → 3072 dims  (better quality)
EMBEDDING_MODEL=text-embedding-3-small

# Whisper model for audio transcription (OpenAI Whisper API)
# whisper-1 is the only model available via the API
WHISPER_MODEL=whisper-1

# Path to ffmpeg executable (required for OGG→MP3 conversion on Windows)
# Linux/macOS: leave empty if ffmpeg is on PATH
# Windows example: C:\ffmpeg\ffmpeg.exe
FFMPEG_PATH=
